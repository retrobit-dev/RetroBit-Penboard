<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Pegangan: digeser untuk memindahkan papan; juga tombol aksi cepat. -->
    <LinearLayout
        android:id="@+id/overlay_handle"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_overlay_handle"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/overlay_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/overlay_title"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/overlay_keyboard"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/overlay_hide_keyboard"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/overlay_close"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/overlay_close"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/overlay_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/overlay_toolbar_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/overlay_row_main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <dev.retrobit.penboard.board.BoardView
                android:id="@+id/overlay_board"
                android:layout_width="0dp"
                android:layout_height="260dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/overlay_toolbar_side"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical" />

            <!-- Grid 3x3 untuk operasi cepat (tata letak "papan di kiri, tombol di kanan"). -->
            <LinearLayout
                android:id="@+id/overlay_grid"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/overlay_toolbar_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/overlay_key_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</LinearLayout>
