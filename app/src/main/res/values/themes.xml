<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema retro cyberpunk grayscale ePaper: jendela hitam, kartu abu gelap,
         huruf mesin tik (monospace), garis tepi tipis. -->
    <style name="Theme.Penboard" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@color/window_bg</item>
        <item name="colorSecondary">@color/brand</item>
        <item name="colorOnSecondary">@color/window_bg</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/window_bg</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/window_bg</item>
    </style>

    <!-- Tema terang: kertas ePaper, huruf gelap, supaya pengaturan tetap terbaca. -->
    <style name="Theme.Penboard.Light" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/on_surface_light</item>
        <item name="colorOnPrimary">@color/paper</item>
        <item name="colorSecondary">@color/on_surface_light</item>
        <item name="colorOnSecondary">@color/paper</item>
        <item name="colorSurface">@color/paper</item>
        <item name="colorOnSurface">@color/on_surface_light</item>
        <item name="android:textColorPrimary">@color/on_surface_light</item>
        <item name="android:textColorSecondary">@color/on_surface_light</item>
        <item name="android:windowBackground">@color/window_bg_light</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/window_bg_light</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/window_bg_light</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <!-- Tema jendela keyboard: latar transparan supaya tingkat transparansi
         panel yang diatur pengguna terlihat apa adanya. -->
    <style name="Theme.Penboard.Ime" parent="Theme.Penboard">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
