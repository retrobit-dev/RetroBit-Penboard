<?xml version="1.0" encoding="utf-8"?>
<!--
  Penboard menolak mode "tulisan tangan stylus" bawaan sistem
  (android:supportsStylusHandwriting="false") supaya bantalan tulisan tangan
  perangkat (mis. Huawei/Celia) tidak menyerobot saat pengguna menulis di papan
  Penboard. Untuk memakai mesin Huawei, pengguna bisa menekan tombol
  "Huawei" pada grid tombol (Penboard berpindah ke keyboard tersebut).
-->
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:settingsActivity="dev.retrobit.penboard.MainActivity"
    android:supportsStylusHandwriting="false"
    android:supportsSwitchingToNextInputMethod="true"
    tools:targetApi="34">
    <subtype
        android:icon="@mipmap/ic_launcher"
        android:imeSubtypeLocale="id_ID"
        android:imeSubtypeMode="keyboard"
        android:isAsciiCapable="true"
        android:label="@string/app_name" />
</input-method>
