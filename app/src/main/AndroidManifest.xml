<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Hanya dipakai untuk menyimpan PNG di Android 9 ke bawah -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Papan tulis melayang (overlay) di atas aplikasi lain. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Penboard">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".TestActivity"
            android:exported="false"
            android:label="@string/test_title"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".BoardEditorActivity"
            android:exported="false"
            android:label="@string/editor_title"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <service
            android:name=".overlay.PenboardOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:label="@string/overlay_title">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="papan tulis melayang yang dipakai pengguna untuk menulis dengan stylus di atas aplikasi lain" />
        </service>

        <service
            android:name=".ime.PenboardInputService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:theme="@style/Theme.Penboard.Ime">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
    </application>
</manifest>
